<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="Priyan Shah portfolio: computer engineering projects, experience, and technical background." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="backdrop"></div>

  <header class="site-header" id="top">
    <div class="container nav-wrap">
      <a href="#top" class="brand"><%= profile.name %></a>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav" id="siteNav">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Computer Engineering Portfolio</p>
          <h1><%= profile.name %></h1>
          <p class="headline"><%= profile.headline %></p>
          <p class="summary"><%= profile.summary %></p>
          <div class="hero-cta">
            <a href="#portfolio" class="btn btn-primary">View Projects</a>
            <a href="<%= profile.resumePath %>" class="btn btn-ghost" target="_blank" rel="noopener">Open Resume</a>
          </div>
          <ul class="quick-meta">
            <li><i class="fa-solid fa-location-dot"></i> <%= profile.location %></li>
            <li><i class="fa-solid fa-envelope"></i> School: <a href="mailto:<%= profile.schoolEmail %>"><%= profile.schoolEmail %></a></li>
            <% if (profile.personalEmail) { %>
              <li><i class="fa-solid fa-at"></i> Personal: <a href="mailto:<%= profile.personalEmail %>"><%= profile.personalEmail %></a></li>
            <% } %>
            <li><i class="fa-brands fa-linkedin"></i> <a href="<%= profile.linkedin %>" target="_blank" rel="noopener">LinkedIn</a></li>
          </ul>
        </div>
        <aside class="hero-card reveal">
          <h2>At a Glance</h2>
          <div class="fact-grid">
            <div>
              <span class="label">Current Focus</span>
              <p>Embedded systems and PCB research with practical software delivery.</p>
            </div>
            <div>
              <span class="label">Degree</span>
              <p>BS in Computer Engineering, Purdue University</p>
            </div>
            <div>
              <span class="label">Expected Graduation</span>
              <p>May 2027</p>
            </div>
            <div>
              <span class="label">Specialization</span>
              <p>Embedded systems and PCB research focused on microcontrollers, FPGAs, and extension-card-ready hardware interfaces.</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section id="about" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">About</p>
          <h2>Building across hardware and software</h2>
        </div>
        <p class="section-copy reveal">
          I enjoy shipping work where circuit-level thinking meets software execution. Recent work includes high-volume configurable product systems at Spry Brands, PCB research and tooling with KiCAD and Altium, and TinyML deployments on resource-constrained hardware.
        </p>
      </div>
    </section>

    <section id="experience" class="section section-tint">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Experience</p>
          <h2>Recent roles and outcomes</h2>
        </div>
        <div class="timeline">
          <% experiences.forEach((item) => { %>
            <article class="timeline-item reveal">
              <div class="timeline-top">
                <h3><%= item.role %></h3>
                <p class="org"><%= item.company %> | <%= item.location %></p>
                <p class="date"><%= item.date %></p>
              </div>
              <ul>
                <% item.bullets.forEach((bullet) => { %>
                  <li><%= bullet %></li>
                <% }); %>
              </ul>
              <div class="chip-row">
                <% item.stack.forEach((tech) => { %>
                  <span class="chip"><%= tech %></span>
                <% }); %>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="portfolio" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Portfolio</p>
          <h2>Project case studies</h2>
          <p class="section-copy">Each project is framed as challenge, implementation, and measurable learning impact.</p>
        </div>
        <div class="portfolio-grid">
          <% projects.forEach((project) => { %>
            <article class="portfolio-card reveal">
              <div class="portfolio-head">
                <p class="project-type"><%= project.type %></p>
                <p class="date"><%= project.date %></p>
              </div>
              <h3><%= project.title %></h3>
              <p><%= project.summary %></p>
              <div class="project-panel">
                <h4>Challenge</h4>
                <p><%= project.challenge %></p>
              </div>
              <div class="project-panel">
                <h4>Impact</h4>
                <p><%= project.impact %></p>
              </div>
              <ul>
                <% project.bullets.forEach((bullet) => { %>
                  <li><%= bullet %></li>
                <% }); %>
              </ul>
              <div class="chip-row">
                <% project.technologies.forEach((tech) => { %>
                  <span class="chip"><%= tech %></span>
                <% }); %>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="education" class="section section-tint">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Education</p>
          <h2>Academic foundation</h2>
        </div>
        <div class="edu-grid">
          <% education.forEach((item) => { %>
            <article class="edu-card reveal">
              <h3><%= item.school %></h3>
              <p class="org"><%= item.degree %></p>
              <p class="date"><%= item.date %> | <%= item.location %></p>
              <ul>
                <% item.highlights.forEach((note) => { %>
                  <li><%= note %></li>
                <% }); %>
              </ul>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Skills</p>
          <h2>Technical toolkit</h2>
        </div>
        <div class="skills-grid">
          <article class="skill-card reveal">
            <h3>Programming</h3>
            <div class="chip-row">
              <% skills.programming.forEach((skill) => { %>
                <span class="chip"><%= skill %></span>
              <% }); %>
            </div>
          </article>
          <article class="skill-card reveal">
            <h3>Hardware</h3>
            <div class="chip-row">
              <% skills.hardware.forEach((skill) => { %>
                <span class="chip"><%= skill %></span>
              <% }); %>
            </div>
          </article>
          <article class="skill-card reveal">
            <h3>Tools</h3>
            <div class="chip-row">
              <% skills.tools.forEach((skill) => { %>
                <span class="chip"><%= skill %></span>
              <% }); %>
            </div>
          </article>
          <article class="skill-card reveal">
            <h3>Spoken Languages</h3>
            <div class="chip-row">
              <% skills.languages.forEach((skill) => { %>
                <span class="chip"><%= skill %></span>
              <% }); %>
            </div>
          </article>
        </div>

        <article class="award-card reveal">
          <h3>Certifications and Awards</h3>
          <ul>
            <% certificationsAndAwards.forEach((item) => { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </article>
      </div>
    </section>

    <section id="contact" class="section section-tint">
      <div class="container contact-wrap reveal">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Let us connect</h2>
          <p class="section-copy">I am open to internships, collaborative engineering projects, and technical conversations.</p>
          <ul class="quick-meta">
            <li><i class="fa-solid fa-phone"></i> <a href="tel:<%= profile.phone %>"><%= profile.phone %></a></li>
            <li><i class="fa-solid fa-envelope"></i> School: <a href="mailto:<%= profile.schoolEmail %>"><%= profile.schoolEmail %></a></li>
            <% if (profile.personalEmail) { %>
              <li><i class="fa-solid fa-at"></i> Personal: <a href="mailto:<%= profile.personalEmail %>"><%= profile.personalEmail %></a></li>
            <% } %>
            <li><i class="fa-solid fa-globe"></i> <a href="<%= profile.website %>" target="_blank" rel="noopener">Personal Website</a></li>
          </ul>
        </div>

        <form id="contactForm" class="contact-form" novalidate>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />

          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />

          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>

          <button type="submit" class="btn btn-primary">Send Message</button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-wrap">
      <p>&copy; 2026 <%= profile.name %></p>
      <div class="footer-links">
        <a href="<%= profile.linkedin %>" target="_blank" rel="noopener">LinkedIn</a>
        <a href="<%= profile.resumePath %>" target="_blank" rel="noopener">Resume</a>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
